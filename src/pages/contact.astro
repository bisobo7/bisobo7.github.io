---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { business } from '../data/business.js';

const title = 'Contact Us | Dixie Auto Land - Saginaw, MI';
const description = `Visit Dixie Auto Land at ${business.address.street}, Saginaw, MI or call ${business.phone}. Ask about a vehicle, request a part, or schedule a test drive.`;
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">Contact</li>
        </ol>
      </nav>
      <h1>Contact Dixie Auto Land</h1>
      <p class="page-hero-sub">Ask about a vehicle, request a part, or just tell us what you're looking for.</p>
    </div>
  </section>

  <section id="part-request">
    <div class="container">
      <div class="contact-content">
        <InquiryForm
          subject="Contact form — dixieauto.land"
          heading="Send Us a Message"
          messagePlaceholder="Looking for a vehicle? Need a part? Include year, make, and model if you have it."
        />

        <div class="contact-info animate-on-scroll">
          <div class="info-item">
            <svg class="info-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M12,2 C8.13,2 5,5.13 5,9 C5,14.25 12,22 12,22 C12,22 19,14.25 19,9 C19,5.13 15.87,2 12,2 Z M12,11.5 C10.62,11.5 9.5,10.38 9.5,9 C9.5,7.62 10.62,6.5 12,6.5 C13.38,6.5 14.5,7.62 14.5,9 C14.5,10.38 13.38,11.5 12,11.5 Z"/>
            </svg>
            <div class="info-content">
              <h4>Our Location</h4>
              <p>{business.address.street}</p>
              <p>{business.address.city}, {business.address.state} {business.address.zip}</p>
            </div>
          </div>
          <div class="info-item">
            <svg class="info-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5C20.55,15.5 21,15.95 21,16.5V20C21,20.55 20.55,21 20,21C10.61,21 3,13.39 3,4C3,3.45 3.45,3 4,3H7.5C8.05,3 8.5,3.45 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z"/>
            </svg>
            <div class="info-content">
              <h4>Phone</h4>
              <p><a href={business.phoneHref}>{business.phone}</a></p>
            </div>
          </div>

          <div class="hours">
            <h3>Business Hours</h3>
            {business.hours.map((h) => (
              <p><span>{h.days}:</span> <span>{h.open ? `${h.open} - ${h.close}` : 'Closed'}</span></p>
            ))}
          </div>

          <div class="map">
            <img src="/images/map-static.svg" alt="Map showing Dixie Auto Land's location on Dixie Hwy in Saginaw" loading="lazy" width="600" height="300" />
            <a href={business.mapsUrl} class="btn btn-secondary" target="_blank" rel="noopener">Open in Google Maps</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
