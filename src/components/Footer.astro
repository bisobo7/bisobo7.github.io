---
// src/components/Footer.astro
import { business } from '../data/business.js';
import { towns } from '../data/towns.js';
const year = new Date().getFullYear();
---

<footer class="footer">
  <!-- Closing CTA band -->
  <div class="footer-cta">
    <div class="container">
      <div class="footer-cta-copy">
        <span class="footer-cta-eyebrow">Visit us on Dixie Hwy</span>
        <h2>Ready to find your next vehicle?</h2>
      </div>
      <div class="footer-cta-actions">
        <a href="/inventory/" class="btn btn-primary">Browse Inventory</a>
        <a href={business.phoneHref} class="btn btn-gold">Call {business.phone}</a>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <img src="/images/dixie-logo-white.svg" alt="Dixie Auto Land" class="logo-small" width="190" height="60" loading="lazy" />
        <p>
          Saginaw's specialist for quality used vehicles and OEM parts — hand-inspected
          cars, transparent pricing, and a nationwide network of over 1,000 partner yards
          for the parts you can't find anywhere else.
        </p>
      </div>

      <div class="footer-col">
        <h4>Explore</h4>
        <ul class="footer-nav">
          <li><a href="/inventory/">Used Cars for Sale</a></li>
          <li><a href="/about/">About Us</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/contact/#part-request">Request a Part</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Areas We Serve</h4>
        <ul class="footer-nav">
          {towns.map((t) => (
            <li><a href={`/service-areas/${t.slug}/`}>{t.name}, MI</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col footer-visit">
        <h4>Visit Us</h4>
        <address>
          <a href={business.mapsUrl} class="footer-address" target="_blank" rel="noopener">
            {business.address.street}<br />
            {business.address.city}, {business.address.state} {business.address.zip}
          </a>
          <a href={business.phoneHref} class="footer-phone">{business.phone}</a>
        </address>
        <dl class="footer-hours">
          {business.hours.map((h) => (
            <div>
              <dt>{h.days}</dt>
              <dd>{h.open ? `${h.open} – ${h.close}` : 'Closed'}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} {business.name}. All rights reserved.</p>
      <p class="footer-mark">Used Vehicles · OEM &amp; Color-Matched Parts · Saginaw, Michigan</p>
    </div>
  </div>
</footer>
