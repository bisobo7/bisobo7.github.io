---
// src/components/Footer.astro
import { business } from '../data/business.js';
import { towns } from '../data/towns.js';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-info">
        <img src="/images/dixie-logo-white.svg" alt="Dixie Auto Land" class="logo-small" width="190" height="60" loading="lazy" />
        <p>
          Dixie Auto Land is Saginaw's specialist for quality used vehicles and OEM parts.
          Transparent pricing, hand-inspected cars, and a nationwide network of over 1,000
          partner yards for the parts you can't find anywhere else.
        </p>
      </div>
      <div class="footer-links">
        <h4>Site</h4>
        <ul class="footer-nav">
          <li><a href="/inventory/">Used Cars for Sale</a></li>
          <li><a href="/about/">About Us</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/contact/#part-request">Request a Part</a></li>
        </ul>
      </div>
      <div class="footer-links">
        <h4>Areas We Serve</h4>
        <ul class="footer-nav">
          {towns.map((t) => (
            <li><a href={`/service-areas/${t.slug}/`}>{t.name}, MI</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-links">
        <h4>Visit Us</h4>
        <address class="footer-contact">
          <p>
            {business.address.street}<br />
            {business.address.city}, {business.address.state} {business.address.zip}
          </p>
          <p><a href={business.phoneHref}>{business.phone}</a></p>
          <div class="footer-hours">
            {business.hours.map((h) => (
              <p>
                <span>{h.days}</span>
                <span>{h.open ? `${h.open} - ${h.close}` : 'Closed'}</span>
              </p>
            ))}
          </div>
        </address>
      </div>
    </div>
    <div class="copyright">
      <p>&copy; {year} {business.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
