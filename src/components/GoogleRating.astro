---
// src/components/GoogleRating.astro
// Google review badge: official 4-colour G, five gold stars, score + count,
// linking out to the Google Business Profile.
//
// Rating and count are hand-maintained in `business.reviews` — see the note
// there about deliberately NOT emitting aggregateRating schema.
import { business } from '../data/business.js';

interface Props {
  /** Extra class on the outer band, e.g. to tune spacing per page. */
  class?: string;
}
const { class: className } = Astro.props;

const { rating, count, url } = business.reviews;

// An empty GBP link degrades to the plain maps URL rather than rendering a
// dead anchor — the profile's reviews are reachable from there either way.
const href = url || business.mapsUrl;

const score = rating.toFixed(1);
const plural = count === 1 ? 'review' : 'reviews';
const label = `Rated ${score} out of 5 stars from ${count} Google ${plural}`;

// Whole / half / empty, so a future 4.7 still renders honestly.
const stars = Array.from({ length: 5 }, (_, i) => {
  const fill = Math.min(1, Math.max(0, rating - i));
  return fill >= 0.75 ? 'full' : fill >= 0.25 ? 'half' : 'empty';
});

const STAR_PATH =
  'M12 2.35l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.36l-5.88 3.1 1.12-6.55L2.48 9.27l6.58-.96z';
---

<div class:list={['review-band', className]}>
  <div class="container">
    <div class="review-badge-wrap animate-on-scroll">
      <a class="review-badge" href={href} target="_blank" rel="noopener">
        <!-- Gradients defined once, referenced by every star below. -->
        <svg class="review-defs" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="dal-star-gold" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#e7c87e" />
              <stop offset="55%" stop-color="#c9a24c" />
              <stop offset="100%" stop-color="#a8842f" />
            </linearGradient>
            <linearGradient id="dal-star-half" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#e7c87e" />
              <stop offset="50%" stop-color="#c9a24c" />
              <stop offset="50%" stop-color="rgba(201, 162, 76, 0.2)" />
              <stop offset="100%" stop-color="rgba(201, 162, 76, 0.2)" />
            </linearGradient>
          </defs>
        </svg>

        <span class="review-body">
          <span class="review-top">
            <span class="review-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path fill="#4285F4" d="M23.06 12.25c0-.85-.08-1.67-.22-2.45H12v4.63h6.2a5.3 5.3 0 0 1-2.3 3.48v2.89h3.72c2.18-2 3.44-4.96 3.44-8.55z"/>
                <path fill="#34A853" d="M12 23.5c3.11 0 5.72-1.03 7.62-2.8l-3.72-2.89c-1.03.7-2.35 1.1-3.9 1.1-3 0-5.54-2.02-6.45-4.75L1.7 14.14A11.5 11.5 0 0 0 12 23.5z"/>
                <path fill="#FBBC05" d="M5.55 14.16a6.9 6.9 0 0 1 0-4.32L1.7 6.86a11.5 11.5 0 0 0 0 10.28l3.85-2.98z"/>
                <path fill="#EA4335" d="M12 4.94c1.69 0 3.21.58 4.4 1.72l3.3-3.3C17.71 1.48 15.1.5 12 .5A11.5 11.5 0 0 0 1.7 6.86l3.85 2.98C6.46 7.11 9 4.94 12 4.94z"/>
              </svg>
            </span>

            <span class="review-stars" role="img" aria-label={label}>
              {stars.map((kind, i) => (
                <svg class:list={['review-star', `is-${kind}`]} style={`--i:${i}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d={STAR_PATH} />
                </svg>
              ))}
            </span>

            <span class="review-score" aria-hidden="true">{score}</span>
          </span>

          <span class="review-count">
            Out of 5 &middot; {count} Google {plural}
          </span>
        </span>

        <span class="review-cta">
          View on Google
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</div>
