---
// src/components/InquiryForm.astro
// Static-friendly lead form (Web3Forms). Works without JS (posts + redirect);
// with JS it submits inline and shows a status message.
import { business } from '../data/business.js';

interface Props {
  quote?: boolean;
  subject?: string;
  vehicle?: string; // pre-fill "Vehicle of Interest"
  heading?: string;
  messageLabel?: string;
  messagePlaceholder?: string;
}
const {
  quote = false,
  subject = 'Website inquiry — Dixie Auto Land',
  vehicle = '',
  heading = 'Send Us a Message',
  messageLabel = 'Your Message',
  messagePlaceholder = 'How can we help?',
} = Astro.props;
const configured = Boolean(business.web3formsKey && business.web3formsKey !== 'YOUR_WEB3FORMS_ACCESS_KEY');
---

<form
  class="contact-form animate-on-scroll js-inquiry-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  data-quote={quote ? "true" : undefined}
  data-configured={String(configured)}
  data-clarity-mask="true"
>
  <h3>{heading}</h3>
  <input type="hidden" name="access_key" value={business.web3formsKey} />
  <input type="hidden" name="subject" value={subject} />
  <input type="hidden" name="from_name" value="dixieauto.land" />
  {quote && <input type="hidden" name="calculation_summary" id="calculation-summary" />}
  {quote && <p>Your estimate summary above accompanies this request. We use your details to respond; this does not subscribe you to marketing.</p>}
  <!-- Honeypot -->
  <input type="checkbox" name="botcheck" class="hp-field" tabindex="-1" autocomplete="off" />

  <div class="form-group">
    <label for="name">Full Name</label>
    <input type="text" id="name" name="name" placeholder="Your name" required autocomplete="name" />
  </div>
  <div class="form-group">
    <label for="phone">Phone Number{quote ? " (optional)" : ""}</label>
    <input type="tel" id="phone" name="phone" placeholder="(989) 555-0100" required={!quote} autocomplete="tel" />
  </div>
  <div class="form-group">
    <label for="email">Email Address</label>
    <input type="email" id="email" name="email" placeholder="you@example.com" required={quote} autocomplete="email" />
  </div>
  <div class="form-group" hidden={quote}>
    <label for="vehicle">Vehicle or Part of Interest</label>
    <input type="text" id="vehicle" name="vehicle" placeholder="e.g. 2018 F-150, or a part + year/make/model" value={vehicle} />
  </div>
  <div class="form-group">
    <label for="message">{messageLabel}</label>
    <textarea id="message" name="message" placeholder={messagePlaceholder} required={!quote}></textarea>
  </div>
  {!configured && <p class="form-unavailable">Online inquiries are temporarily unavailable. Please call <a href={business.phoneHref}>{business.phone}</a>{quote ? " and keep or print your estimate" : ""}.</p>}
  <button type="submit" class="btn btn-primary" disabled={!configured}>{quote ? "Send quote request" : "Send Inquiry"}</button>
  <p class="form-status" role="status" aria-live="polite"></p>
  <p class="form-note">We typically reply within one business day. Prefer to talk? Call <a href={business.phoneHref}>{business.phone}</a>.</p>
</form>

<script>
  import { submitInquiry } from '../utils/inquiry.js';
  // Inline submit for all inquiry forms on the page
  document.querySelectorAll('.js-inquiry-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = form as HTMLFormElement;
      const status = f.querySelector('.form-status') as HTMLElement;
      const btn = f.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (f.dataset.configured !== 'true') return;
      const preparation = new CustomEvent('inquiry:prepare', { cancelable: true });
      if (!f.dispatchEvent(preparation)) return;
      btn.disabled = true;
      status.textContent = 'Sending…';
      status.className = 'form-status';
      try {
        await submitInquiry(f.action, new FormData(f));
        f.dispatchEvent(new CustomEvent('inquiry:accepted'));
        if (f.dataset.quote !== 'true') f.reset();
        status.textContent = "Your inquiry was accepted. We typically reply within one business day.";
        status.classList.add('ok');
      } catch {
        status.textContent = 'Your inquiry could not be confirmed. Your entries are saved on this page; please retry or call us.';
        status.classList.add('err');
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
