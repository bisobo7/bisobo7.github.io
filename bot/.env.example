# Copy to bot/.env and fill in. bot/.env is gitignored — keep it that way.

# From @BotFather. If this ever leaks, /revoke in BotFather and regenerate.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID — the allowlist. Message @userinfobot to get it.
# Comma-separate if more than one person should be able to publish.
# Without this set, the bot refuses to start: an open bot can publish to your lot.
TELEGRAM_OWNER_IDS=

# GitHub fine-grained personal access token.
# Scope it to ONLY this repo, with Repository permissions > Contents: Read and write.
# Nothing else. https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Where listings get committed.
GITHUB_OWNER=bisobo7
GITHUB_REPO=bisobo7.github.io
GITHUB_BRANCH=main

# Public site root, used to build the "it's live" links.
SITE_URL=https://dixieauto.land
