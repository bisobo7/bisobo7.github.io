---
// src/pages/service-areas/index.astro — service-area hub
import BaseLayout from '../../layouts/BaseLayout.astro';
import { towns } from '../../data/towns.js';
import { business } from '../../data/business.js';

const title = 'Areas We Serve | Dixie Auto Land - Saginaw, MI';
const description =
  'Dixie Auto Land serves used car and auto parts customers across the Great Lakes Bay Region — Saginaw, Bay City, Midland, Flint, Bridgeport, and Frankenmuth, MI.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: business.domain + '/' },
    { '@type': 'ListItem', position: 2, name: 'Areas We Serve', item: business.domain + '/service-areas/' },
  ],
};
---

<BaseLayout title={title} description={description} schema={[breadcrumbSchema]}>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">Areas We Serve</li>
        </ol>
      </nav>
      <span class="page-hero-eyebrow">The Great Lakes Bay Region</span>
      <h1>Areas We Serve</h1>
      <p class="page-hero-sub">
        One lot on Dixie Hwy in Saginaw — trusted by drivers across the region for
        hand-inspected used vehicles and nationwide parts sourcing.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header animate-on-scroll">
        <span class="section-eyebrow">Worth the Drive</span>
        <h2 class="section-title">Choose Your City</h2>
        <p class="section-lead">
          Every page below has real directions, drive times, and what customers from
          your town most often come to us for.
        </p>
      </div>
      <div class="towns-grid">
        {towns.map((t) => (
          <a href={`/service-areas/${t.slug}/`} class="town-card animate-on-scroll">
            <h3>{t.name}, MI</h3>
            <p class="town-distance">{t.driveTime} away</p>
            <p>{t.teaser}</p>
            <span class="town-cta">Used Cars &amp; Parts near {t.name} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="about">
    <div class="container text-center">
      <div class="section-header animate-on-scroll">
        <span class="section-eyebrow">One Destination</span>
        <h2 class="section-title">Why Drivers Cross Town to Reach Us</h2>
        <p class="section-lead">
          Hand-inspected vehicles with honest condition notes, financing for a range of
          credit situations, and a 1,000+ yard parts network no local lot can match.
        </p>
      </div>
      <div class="hero-actions" style="justify-content:center">
        <a href="/inventory/" class="btn btn-primary">Browse Inventory</a>
        <a href={business.phoneHref} class="btn btn-secondary">Call {business.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>
